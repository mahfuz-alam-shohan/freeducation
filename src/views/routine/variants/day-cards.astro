---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import type { RoutineViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: RoutineViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const { routine } = vm

// A day at a time rather than a week at a glance: nothing scrolls sideways, which is
// what a student on a phone actually wants.
const days = routine
  ? routine.days.map((day, dayIndex) => ({
      label: resolveText(day, locale),
      lessons: routine.periods
        .map((period, periodIndex) => ({ period, cell: routine.grid[dayIndex]?.[periodIndex] ?? null }))
        .filter(entry => entry.cell !== null),
    }))
  : []
---
<Container>
  <PageHeading
    title={resolveText(vm.title, locale)}
    subtitle={routine?.updatedAt ? `${t('common.updated')} ${formatDate(routine.updatedAt, locale)}` : undefined}
  />

  {vm.classes.length > 1 && (
    <nav class="fe-classes" aria-label={t('routine.selectClass')}>
      {vm.classes.map(entry => (
        <a href={`/${vm.basePath}?class=${entry.id}`} aria-current={entry.id === vm.selected?.id ? 'page' : undefined}>
          {resolveText(entry.label, locale)}
        </a>
      ))}
    </nav>
  )}

  {!routine ? <EmptyState message={t('routine.empty')} /> : (
    <div class="fe-days">
      {days.map(day => (
        <section>
          <h2>{day.label}</h2>
          {day.lessons.length === 0 ? <p class="fe-free">{t('routine.free')}</p> : (
            <ol>
              {day.lessons.map(({ period, cell }) => (
                <li>
                  <span class="fe-when">
                    {period.startsAt
                      ? <time>{period.startsAt}</time>
                      : <span>{resolveText(period.label, locale)}</span>}
                  </span>
                  <span class="fe-what">
                    <strong>{resolveText(cell!.subject, locale)}</strong>
                    {cell!.teacher && <small>{resolveText(cell!.teacher, locale)}</small>}
                  </span>
                  {cell!.room && <span class="fe-where">{cell!.room}</span>}
                </li>
              ))}
            </ol>
          )}
        </section>
      ))}
    </div>
  )}
</Container>

<style>
  .fe-classes { display: flex; flex-wrap: wrap; gap: var(--fe-space-2); margin-block-end: var(--fe-space-6); }
  .fe-classes a { padding: var(--fe-space-2) var(--fe-space-4); border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-sm); text-decoration: none; color: var(--fe-color-text); font-size: var(--fe-size-sm); }
  .fe-classes a[aria-current='page'] { background: var(--fe-color-primary); color: var(--fe-color-primaryText); border-color: var(--fe-color-primary); }

  .fe-days { display: grid; gap: var(--fe-space-6); grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }

  section { border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-sm); padding: var(--fe-space-4); break-inside: avoid; }
  h2 { margin: 0 0 var(--fe-space-3); padding-block-end: var(--fe-space-2); border-block-end: 2px solid var(--fe-color-primary); font-size: var(--fe-size-base); }

  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--fe-space-3); }
  li { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: var(--fe-space-3); align-items: baseline; }
  .fe-when { color: var(--fe-color-textMuted); font-size: var(--fe-size-xs); font-variant-numeric: tabular-nums; }
  .fe-what strong { display: block; font-size: var(--fe-size-sm); font-weight: var(--fe-weight-semibold); }
  .fe-what small { display: block; color: var(--fe-color-textMuted); font-size: var(--fe-size-2xs); }
  .fe-where { color: var(--fe-color-textMuted); font-size: var(--fe-size-2xs); }
  .fe-free { margin: 0; color: var(--fe-color-textMuted); font-size: var(--fe-size-sm); }

  @media print { .fe-classes { display: none; } .fe-days { grid-template-columns: repeat(2, 1fr); } }
</style>
