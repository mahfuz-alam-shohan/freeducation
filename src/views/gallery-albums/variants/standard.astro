---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import type { GalleryAlbumsViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: GalleryAlbumsViewModel; locale: Locale; t: Translator }
const { vm, locale, t } = Astro.props
---
<Container>
  <PageHeading title={resolveText(vm.title, locale)} />
  {vm.albums.length === 0 ? <EmptyState message={t('gallery.empty')} /> : (
    <ul class="fe-albums">
      {vm.albums.map(album => (
        <li>
          <a href={`/${vm.basePath}/${album.slug}`}>
            {album.cover?.url
              ? <img src={album.cover.url} alt="" loading="lazy" decoding="async" />
              : <span class="fe-placeholder" aria-hidden="true"></span>}
            <strong>{resolveText(album.title, locale)}</strong>
            {album.takenAt && <small>{formatDate(album.takenAt, locale)}</small>}
          </a>
        </li>
      ))}
    </ul>
  )}
</Container>
<style>
  .fe-albums { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--fe-space-4); grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  .fe-albums a { display: block; text-decoration: none; color: var(--fe-color-text); border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-md); overflow: hidden; }
  .fe-albums img, .fe-placeholder { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--fe-color-surface); }
  .fe-albums strong, .fe-albums small { display: block; padding-inline: var(--fe-space-3); }
  .fe-albums strong { padding-top: var(--fe-space-3); }
  .fe-albums small { padding-bottom: var(--fe-space-3); color: var(--fe-color-textMuted); }
</style>
