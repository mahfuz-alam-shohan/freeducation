---
import Band from '../../../ui/Band.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import Icon from '../../../ui/Icon.astro'
import PageBanner from '../../../ui/PageBanner.astro'
import type { EventListViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDateParts, formatTime, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: EventListViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
---
<!-- Events as rows led by a solid date block, the standard school-diary pattern. -->
<PageBanner title={resolveText(vm.title, locale)} />

<Band>
  {vm.events.length === 0 ? <EmptyState message={t('event.empty')} /> : (
    <ul class="fe-diary">
      {vm.events.map(event => {
        const on = formatDateParts(event.startsAt, locale, vm.timeZone)
        return (
          <li>
            <a href={`/${vm.basePath}/${event.slug}`}>
              <time class="fe-date" datetime={event.startsAt}>
                <b>{on.day}</b><i>{on.month}</i>
              </time>
              <span class="fe-what">
                <strong>{resolveText(event.title, locale)}</strong>
                {event.description && <span class="fe-sum">{resolveText(event.description, locale)}</span>}
                <span class="fe-when">
                  <span><Icon name="clock" size={13} />{formatTime(event.startsAt, locale, vm.timeZone)}</span>
                  {event.location && (
                    <span><Icon name="pin" size={13} />{resolveText(event.location, locale)}</span>
                  )}
                </span>
              </span>
              <Icon name="arrow-right" size={16} class="fe-go" />
            </a>
          </li>
        )
      })}
    </ul>
  )}
</Band>

<style>
  .fe-diary { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--fe-space-4); }
  .fe-diary a {
    display: flex; align-items: flex-start; gap: var(--fe-space-6);
    padding: var(--fe-space-6);
    border: 1px solid var(--fe-color-border);
    text-decoration: none; color: var(--fe-color-text);
    transition: border-color 220ms ease, background-color 220ms ease;
  }
  .fe-diary a:hover { border-color: var(--fe-color-primary); background: var(--fe-color-surface); }

  .fe-date {
    flex: none; inline-size: 4.5rem; padding-block: var(--fe-space-3);
    display: grid; justify-items: center; gap: 2px;
    background: var(--fe-color-primary); color: var(--fe-color-primaryText);
    border-block-end: 3px solid var(--fe-color-accent);
    line-height: 1;
  }
  .fe-date b { font-size: var(--fe-size-xl); font-weight: var(--fe-weight-semibold); font-variant-numeric: tabular-nums; }
  .fe-date i { font-style: normal; font-size: var(--fe-size-3xs); text-transform: uppercase; letter-spacing: 0.16em; opacity: 0.82; }

  .fe-what { flex: 1; min-inline-size: 0; display: grid; gap: var(--fe-space-2); }
  .fe-what strong { font-size: var(--fe-size-lg); font-weight: var(--fe-weight-medium); line-height: var(--fe-leading-snug); }
  .fe-sum { color: var(--fe-color-textMuted); font-size: var(--fe-size-sm); line-height: var(--fe-leading-snug); }
  .fe-when { display: flex; flex-wrap: wrap; gap: var(--fe-space-2) var(--fe-space-6); }
  .fe-when span {
    display: inline-flex; align-items: center; gap: 5px;
    color: var(--fe-color-accent); font-size: var(--fe-size-2xs);
    font-weight: var(--fe-weight-semibold); text-transform: uppercase; letter-spacing: 0.12em;
  }

  :global(.fe-go) { flex: none; margin-block-start: var(--fe-space-2); color: var(--fe-color-textMuted); transition: transform 240ms ease; }
  .fe-diary a:hover :global(.fe-go) { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) { :global(.fe-go) { transition: none; } }
</style>
