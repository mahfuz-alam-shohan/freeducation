---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import type { EventListViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: EventListViewModel; locale: Locale; t: Translator }
const { vm, locale, t } = Astro.props
---
<Container>
  <PageHeading title={resolveText(vm.title, locale)} />
  {vm.events.length === 0 ? <EmptyState message={t('event.empty')} /> : (
    <ul class="fe-events">
      {vm.events.map(event => (
        <li>
          <time datetime={event.startsAt}>{formatDate(event.startsAt, locale)}</time>
          <div>
            <a href={`/${vm.basePath}/${event.slug}`}>{resolveText(event.title, locale)}</a>
            {event.location && <small>{resolveText(event.location, locale)}</small>}
          </div>
        </li>
      ))}
    </ul>
  )}
</Container>
<style>
  .fe-events { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--fe-space-3); }
  .fe-events li { display: flex; gap: var(--fe-space-4); align-items: baseline; padding: var(--fe-space-3); border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-md); }
  .fe-events time { color: var(--fe-color-primary); font-size: var(--fe-size-sm); white-space: nowrap; min-width: 9rem; }
  .fe-events a { color: var(--fe-color-text); text-decoration: none; }
  .fe-events a:hover { color: var(--fe-color-primary); text-decoration: underline; }
  .fe-events small { display: block; color: var(--fe-color-textMuted); }
</style>
