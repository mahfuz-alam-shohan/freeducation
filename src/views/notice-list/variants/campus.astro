---
import Band from '../../../ui/Band.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import FilterBar from '../../../ui/FilterBar.astro'
import Icon from '../../../ui/Icon.astro'
import PageBanner from '../../../ui/PageBanner.astro'
import Pagination from '../../../ui/Pagination.astro'
import type { NoticeListViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: NoticeListViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
---
<!-- A coloured title band, then the notices as full-width rows with a date rail. -->
<PageBanner title={resolveText(vm.title, locale)} />

<Band>
  <FilterBar
    label={t('notice.title')}
    items={vm.filters.map(filter => ({ ...filter, label: resolveText(filter.label, locale) }))}
  />

  {vm.notices.length === 0 ? <EmptyState message={t('notice.empty')} /> : (
    <ul class="fe-rows">
      {vm.notices.map(notice => (
        <li>
          <a href={`/${vm.basePath}/${notice.slug}`}>
            <span class="fe-meta">
              <time datetime={notice.publishedAt}>{formatDate(notice.publishedAt, locale)}</time>
              {notice.pinned && <em>{t('notice.pinned')}</em>}
            </span>
            <span class="fe-body">
              <strong>{resolveText(notice.title, locale)}</strong>
              {notice.summary && <span class="fe-sum">{resolveText(notice.summary, locale)}</span>}
            </span>
            <Icon name="arrow-right" size={16} class="fe-go" />
          </a>
          {notice.attachments.length > 0 && (
            <p class="fe-files">
              {notice.attachments.map(file => (
                <a href={file.url} download><Icon name="download" size={13} />{resolveText(file.label, locale)}</a>
              ))}
            </p>
          )}
        </li>
      ))}
    </ul>
  )}

  <Pagination
    page={vm.page} pageSize={vm.pageSize} total={vm.total} basePath={vm.basePath}
    labels={{ previous: t('common.previous'), next: t('common.next'), page: t('common.page') }}
  />
</Band>

<style>
  .fe-rows { list-style: none; margin: 0; padding: 0; }
  .fe-rows li { border-block-end: 1px solid var(--fe-color-border); }
  .fe-rows li:first-child { border-block-start: 1px solid var(--fe-color-border); }

  .fe-rows > li > a {
    display: grid; gap: var(--fe-space-2);
    padding: var(--fe-space-6) var(--fe-space-4) var(--fe-space-6) 0;
    text-decoration: none; color: var(--fe-color-text);
    transition: background-color 220ms ease, padding-inline-start 220ms ease;
  }
  @media (min-width: 48rem) {
    .fe-rows > li > a {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
      gap: var(--fe-space-6); align-items: baseline;
    }
  }
  .fe-rows > li > a:hover { background: var(--fe-color-surface); padding-inline-start: var(--fe-space-4); }

  .fe-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--fe-space-3); }
  .fe-meta time {
    color: var(--fe-color-accent); font-size: var(--fe-size-2xs);
    font-weight: var(--fe-weight-semibold); text-transform: uppercase; letter-spacing: 0.14em;
  }
  .fe-meta em {
    font-style: normal; color: var(--fe-color-primary);
    font-size: var(--fe-size-3xs); text-transform: uppercase; letter-spacing: 0.16em;
  }

  .fe-body { display: grid; gap: var(--fe-space-2); min-inline-size: 0; }
  .fe-body strong { font-size: var(--fe-size-lg); font-weight: var(--fe-weight-medium); line-height: var(--fe-leading-snug); }
  .fe-sum { color: var(--fe-color-textMuted); font-size: var(--fe-size-sm); line-height: var(--fe-leading-snug); }

  :global(.fe-go) { color: var(--fe-color-textMuted); transition: transform 240ms ease, color 240ms ease; }
  .fe-rows > li > a:hover :global(.fe-go) { transform: translateX(3px); color: var(--fe-color-accent); }

  .fe-files { display: flex; flex-wrap: wrap; gap: var(--fe-space-3) var(--fe-space-6); margin: 0 0 var(--fe-space-6); }
  @media (min-width: 48rem) { .fe-files { padding-inline-start: calc(11rem + var(--fe-space-6)); } }
  .fe-files a {
    display: inline-flex; align-items: center; gap: 5px;
    color: var(--fe-color-primary); text-decoration: none;
    font-size: var(--fe-size-2xs); font-weight: var(--fe-weight-medium);
  }
  .fe-files a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) { :global(.fe-go) { transition: none; } }
</style>
