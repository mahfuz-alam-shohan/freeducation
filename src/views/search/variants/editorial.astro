---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import Icon from '../../../ui/Icon.astro'
import Panel from '../../../ui/Panel.astro'
import Pagination from '../../../ui/Pagination.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import type { SearchViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, formatNumber, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: SearchViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
---
<!-- The search box framed like every other panel, the hits as ruled rows. -->
<Container>
  <PageHeading title={resolveText(vm.title, locale)} />

  <form class="fe-searchbox" method="get" action={`/${vm.basePath}`} role="search">
    <label class="fe-sr" for="q">{t('search.placeholder')}</label>
    <span class="fe-lens"><Icon name="search" size={16} /></span>
    <input id="q" name="q" type="search" value={vm.query} placeholder={t('search.placeholder')} />
    <button type="submit">{t('common.search')}</button>
  </form>

  {!vm.query && <EmptyState message={t('search.prompt')} />}
  {vm.query && vm.hits.length === 0 && <EmptyState message={t('search.empty')} />}

  {vm.hits.length > 0 && (
    <Panel title={`${t('search.results')} · ${formatNumber(vm.total, locale)}`} icon="search" headingId="h-hits" flush>
      <ul class="fe-hits">
        {vm.hits.map(hit => (
          <li>
            <a href={`/${hit.path}`}>
              <span class="fe-hit">
                <strong>{resolveText(hit.title, locale)}</strong>
                {hit.snippet && <span class="fe-snip">{resolveText(hit.snippet, locale)}</span>}
                <span class="fe-path">
                  /{hit.path}
                  {hit.date && <time datetime={hit.date}>{formatDate(hit.date, locale)}</time>}
                </span>
              </span>
              <Icon name="arrow-right" size={14} class="fe-go" />
            </a>
          </li>
        ))}
      </ul>
    </Panel>
  )}

  <Pagination
    page={vm.page} pageSize={vm.pageSize} total={vm.total} basePath={vm.basePath}
    labels={{ previous: t('common.previous'), next: t('common.next'), page: t('common.page') }}
  />
</Container>

<style>
  .fe-searchbox {
    display: flex; align-items: stretch;
    margin-block-end: var(--fe-space-6); max-inline-size: 38rem;
    border: 1px solid var(--fe-color-border);
  }
  .fe-lens { display: grid; place-items: center; padding-inline: var(--fe-space-4); color: var(--fe-color-textMuted); }
  .fe-searchbox input {
    flex: 1; min-inline-size: 0;
    padding: var(--fe-space-4) var(--fe-space-2);
    border: 0; background: transparent; color: var(--fe-color-text);
    font: inherit; font-size: var(--fe-size-sm);
  }
  .fe-searchbox input:focus-visible { outline: 0; }
  .fe-searchbox:focus-within { border-color: var(--fe-color-accent); }
  .fe-searchbox button {
    padding-inline: var(--fe-space-8);
    border: 0; border-inline-start: 1px solid var(--fe-color-border);
    background: var(--fe-color-primary); color: var(--fe-color-primaryText);
    font: inherit; font-size: var(--fe-size-2xs); font-weight: var(--fe-weight-semibold);
    text-transform: uppercase; letter-spacing: 0.16em; cursor: pointer;
  }
  .fe-sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .fe-hits { list-style: none; margin: 0; padding: var(--fe-space-2) 0; }
  .fe-hits li + li { border-block-start: 1px solid var(--fe-rule-hair); }
  .fe-hits a {
    display: flex; align-items: center; gap: var(--fe-space-4);
    padding: var(--fe-space-4) var(--fe-space-6);
    text-decoration: none; color: var(--fe-color-text);
    transition: background-color 220ms ease;
  }
  .fe-hits a:hover { background: var(--fe-color-surface); }

  .fe-hit { flex: 1; min-inline-size: 0; display: grid; gap: var(--fe-space-2); }
  .fe-hit strong { font-size: var(--fe-size-base); font-weight: var(--fe-weight-medium); line-height: var(--fe-leading-snug); }
  .fe-snip { color: var(--fe-color-textMuted); font-size: var(--fe-size-sm); line-height: var(--fe-leading-snug); }
  .fe-path {
    display: flex; flex-wrap: wrap; gap: var(--fe-space-4);
    color: var(--fe-color-textMuted); font-size: var(--fe-size-3xs);
    text-transform: uppercase; letter-spacing: 0.12em;
  }

  :global(.fe-go) { flex: none; color: var(--fe-color-textMuted); transition: transform 240ms ease, color 240ms ease; }
  .fe-hits a:hover :global(.fe-go) { transform: translateX(3px); color: var(--fe-color-accent); }

  @media (prefers-reduced-motion: reduce) { :global(.fe-go) { transition: none; } }
</style>
