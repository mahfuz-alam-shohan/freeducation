---
import Band from '../../../ui/Band.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import Icon from '../../../ui/Icon.astro'
import PageBanner from '../../../ui/PageBanner.astro'
import Photo from '../../../ui/Photo.astro'
import type { GalleryAlbumViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: GalleryAlbumViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const { album } = vm
---
{!album ? (
  <Band><EmptyState message={t('page.notFoundBody')} /></Band>
) : (
  <>
    <PageBanner
      title={resolveText(album.title, locale)}
      subtitle={album.takenAt ? formatDate(album.takenAt, locale) : undefined}
    />

    <Band>
      {album.photos.length === 0 ? <EmptyState message={t('gallery.empty')} /> : (
        <ul class="fe-sheet">
          {album.photos.map(photo => (
            <li><Photo image={photo} locale={locale} width={640} height={480} sizes="(max-width: 40rem) 50vw, 16rem" /></li>
          ))}
        </ul>
      )}

      <a class="fe-back" href={`/${vm.backPath}`}>
        <Icon name="arrow-right" size={15} />{t('common.viewAll')}
      </a>
    </Band>
  </>
)}

<style>
  .fe-sheet {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--fe-space-4);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .fe-sheet li { overflow: hidden; }
  .fe-sheet :global(.fe-photo) {
    display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fe-sheet li:hover :global(.fe-photo) { transform: scale(1.04); }

  .fe-back {
    display: inline-flex; align-items: center; gap: var(--fe-space-2);
    margin-block-start: var(--fe-space-8);
    color: var(--fe-color-primary); text-decoration: none;
    font-size: var(--fe-size-2xs); font-weight: var(--fe-weight-semibold);
    text-transform: uppercase; letter-spacing: 0.14em;
  }
  .fe-back :global(.fe-icon) { transform: rotate(180deg); }
  .fe-back:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) { .fe-sheet :global(.fe-photo) { transition: none; } }
</style>
