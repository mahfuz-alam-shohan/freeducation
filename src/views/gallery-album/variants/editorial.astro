---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import Icon from '../../../ui/Icon.astro'
import Panel from '../../../ui/Panel.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import Photo from '../../../ui/Photo.astro'
import type { GalleryAlbumViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: GalleryAlbumViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const { album } = vm
---
<!-- An album hung as a sheet of prints: even frames, ruled, no rounded corners. -->
<Container>
  {!album ? <EmptyState message={t('page.notFoundBody')} /> : (
    <>
      <PageHeading
        title={resolveText(album.title, locale)}
        subtitle={album.takenAt ? formatDate(album.takenAt, locale) : undefined}
      />

      <Panel>
        {album.photos.length === 0 ? <EmptyState message={t('gallery.empty')} /> : (
          <ul class="fe-sheet">
            {album.photos.map(photo => (
              <li>
                <Photo image={photo} locale={locale} width={480} height={360} sizes="(max-width: 40rem) 50vw, 15rem" />
              </li>
            ))}
          </ul>
        )}
      </Panel>

      <a class="fe-back" href={`/${vm.backPath}`}>
        <Icon name="arrow-right" size={14} />{t('common.viewAll')}
      </a>
    </>
  )}
</Container>

<style>
  .fe-sheet {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--fe-space-4);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .fe-sheet li { border: 1px solid var(--fe-color-border); overflow: hidden; }
  .fe-sheet :global(.fe-photo) {
    display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    transition: transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fe-sheet li:hover :global(.fe-photo) { transform: scale(1.05); }

  .fe-back {
    display: inline-flex; align-items: center; gap: var(--fe-space-2);
    margin-block-start: var(--fe-space-8);
    color: var(--fe-color-textMuted); text-decoration: none;
    font-size: var(--fe-size-2xs); text-transform: uppercase; letter-spacing: 0.16em;
  }
  .fe-back :global(.fe-icon) { transform: rotate(180deg); }
  .fe-back:hover { color: var(--fe-color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .fe-sheet :global(.fe-photo) { transition: none; }
  }
</style>
