---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import Photo from '../../../ui/Photo.astro'
import RuleHeading from '../../../ui/RuleHeading.astro'
import type { GalleryAlbumViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: GalleryAlbumViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const { album } = vm
---
<!-- A picture spread: the first plate runs wide, the rest sit under it. -->
<Container>
  {!album ? <EmptyState message={t('page.notFoundBody')} /> : (
    <>
      <RuleHeading title={resolveText(album.title, locale)} level="page" major />
      {album.takenAt && (
        <p class="fe-when"><time datetime={album.takenAt}>{formatDate(album.takenAt, locale)}</time></p>
      )}

      {album.photos.length === 0 ? <EmptyState message={t('gallery.empty')} /> : (
        <ul class="fe-spread">
          {album.photos.map(photo => (
            <li><Photo image={photo} locale={locale} width={640} height={480} sizes="(max-width: 40rem) 50vw, 16rem" /></li>
          ))}
        </ul>
      )}

      <a class="fe-back" href={`/${vm.backPath}`}>{t('common.viewAll')}</a>
    </>
  )}
</Container>

<style>
  .fe-when { margin: 0 0 var(--fe-space-6); color: var(--fe-color-textMuted); font-size: var(--fe-size-3xs); text-transform: uppercase; letter-spacing: 0.2em; }

  .fe-spread {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--fe-space-4);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  /* The opening plate runs across the measure, the way a spread opens. */
  @media (min-width: 44rem) { .fe-spread li:first-child { grid-column: span 2; } }
  .fe-spread :global(.fe-photo) {
    display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    filter: saturate(0.82) contrast(1.04); transition: filter 600ms ease;
  }
  .fe-spread li:hover :global(.fe-photo) { filter: none; }

  .fe-back {
    display: inline-block; margin-block-start: var(--fe-space-8);
    color: var(--fe-color-textMuted); text-decoration: none;
    font-size: var(--fe-size-3xs); text-transform: uppercase; letter-spacing: 0.18em;
    border-block-end: 1px solid var(--fe-color-border); padding-block-end: 3px;
  }
  .fe-back:hover { color: var(--fe-color-accent); }

  @media (prefers-reduced-motion: reduce) { .fe-spread :global(.fe-photo) { transition: none; } }
</style>
