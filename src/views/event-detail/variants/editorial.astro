---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import Icon from '../../../ui/Icon.astro'
import Photo from '../../../ui/Photo.astro'
import Prose from '../../../ui/Prose.astro'
import type { EventDetailViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, formatTime, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: EventDetailViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const { event } = vm
---
<!-- One event: when and where in a ruled strip, the description set for reading. -->
<Container>
  {!event ? <EmptyState message={t('page.notFoundBody')} /> : (
    <article class="fe-article">
      {event.cover && (
        <figure class="fe-plate">
          <Photo image={event.cover} locale={locale} width={1200} height={600} sizes="(max-width: 64rem) 100vw, 56rem" eager />
        </figure>
      )}

      <h1>{resolveText(event.title, locale)}</h1>

      <dl class="fe-facts">
        <div>
          <dt><Icon name="calendar" size={15} /><span class="fe-sr">{t('event.title')}</span></dt>
          <dd><time datetime={event.startsAt}>{formatDate(event.startsAt, locale)}</time></dd>
        </div>
        <div>
          <dt><Icon name="clock" size={15} /><span class="fe-sr">{t('routine.period')}</span></dt>
          <dd>{formatTime(event.startsAt, locale)}</dd>
        </div>
        {event.location && (
          <div>
            <dt><Icon name="pin" size={15} /><span class="fe-sr">{t('contact.address')}</span></dt>
            <dd>{resolveText(event.location, locale)}</dd>
          </div>
        )}
      </dl>

      {event.description && <div class="fe-body"><Prose html={resolveText(event.description, locale)} /></div>}

      <a class="fe-back" href={`/${vm.backPath}`}>
        <Icon name="arrow-right" size={14} />{t('common.viewAll')}
      </a>
    </article>
  )}
</Container>

<style>
  .fe-article { max-inline-size: 56rem; }

  .fe-plate { margin: 0 0 var(--fe-space-8); border: 1px solid var(--fe-color-border); }
  .fe-plate :global(.fe-photo) { display: block; inline-size: 100%; aspect-ratio: 2 / 1; object-fit: cover; }

  .fe-article h1 {
    margin: 0;
    font-family: var(--fe-font-heading); font-size: var(--fe-size-2xl);
    font-weight: var(--fe-weight-regular);
    line-height: var(--fe-leading-tight); letter-spacing: -0.015em;
  }

  .fe-facts {
    margin: var(--fe-space-6) 0 0;
    display: flex; flex-wrap: wrap;
    border: 1px solid var(--fe-color-border);
  }
  .fe-facts div {
    display: flex; align-items: center; gap: var(--fe-space-3);
    padding: var(--fe-space-4) var(--fe-space-6);
  }
  .fe-facts div + div { border-inline-start: 1px solid var(--fe-color-border); }
  .fe-facts dt { color: var(--fe-color-textMuted); display: flex; }
  .fe-facts dd { margin: 0; font-size: var(--fe-size-sm); }
  .fe-sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .fe-body {
    margin-block-start: var(--fe-space-8);
    max-inline-size: 42rem;
  }

  .fe-back {
    display: inline-flex; align-items: center; gap: var(--fe-space-2);
    margin-block-start: var(--fe-space-8);
    color: var(--fe-color-textMuted); text-decoration: none;
    font-size: var(--fe-size-2xs); text-transform: uppercase; letter-spacing: 0.16em;
  }
  .fe-back :global(.fe-icon) { transform: rotate(180deg); }
  .fe-back:hover { color: var(--fe-color-accent); }

  @media (max-width: 40rem) {
    .fe-facts div { inline-size: 100%; }
    .fe-facts div + div { border-inline-start: 0; border-block-start: 1px solid var(--fe-rule-hair); }
  }
</style>
