---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import Pagination from '../../../ui/Pagination.astro'
import Photo from '../../../ui/Photo.astro'
import type { PersonListViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: PersonListViewModel; locale: Locale; t: Translator }
const { vm, locale, t } = Astro.props
---
<Container>
  <PageHeading title={resolveText(vm.title, locale)} />
  {vm.people.length === 0 ? <EmptyState message={t('person.empty')} /> : (
    <ul class="fe-grid">
      {vm.people.map(person => (
        <li class="fe-person">
          <Photo
            class="fe-avatar" image={person.photo} locale={locale}
            width={96} height={96}
            fallback={resolveText(person.name, locale).slice(0, 1)}
          />
          <strong>{resolveText(person.name, locale)}</strong>
          {person.designation && <span class="fe-role">{resolveText(person.designation, locale)}</span>}
          {person.department && <span class="fe-dept">{resolveText(person.department, locale)}</span>}
        </li>
      ))}
    </ul>
  )}
  <Pagination page={vm.page} pageSize={vm.pageSize} total={vm.total} basePath={vm.basePath}
    labels={{ previous: t('common.previous'), next: t('common.next'), page: t('common.page') }} />
</Container>
<style>
  .fe-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--fe-space-4); grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); }
  .fe-person { text-align: center; padding: var(--fe-space-6) var(--fe-space-4); border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-sm); background: var(--fe-color-bg); }
  .fe-person :global(.fe-avatar) { inline-size: 96px; block-size: 96px; border-radius: 50%; margin: 0 auto var(--fe-space-3); }
  .fe-person strong { display: block; font-size: var(--fe-size-base); }
  .fe-role { display: block; margin-block-start: var(--fe-space-1); color: var(--fe-color-text); font-size: var(--fe-size-sm); }
  .fe-dept { display: block; margin-block-start: var(--fe-space-1); color: var(--fe-color-textMuted); font-size: var(--fe-size-xs); text-transform: uppercase; letter-spacing: 0.06em; }
</style>
