---
import Band from '../../../ui/Band.astro'
import Icon from '../../../ui/Icon.astro'
import PageBanner from '../../../ui/PageBanner.astro'
import type { EventCalendarViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatNumber, formatTime, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: EventCalendarViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const calendar = vm
---
<PageBanner title={resolveText(vm.title, locale)} />

<Band>
  <div class="fe-monthbar">
    <h2>{calendar.label}</h2>
    <nav aria-label={calendar.label}>
      <a href={calendar.previousHref} rel="prev" aria-label={t('common.previous')}>
        <Icon name="chevron-down" size={16} class="fe-prev" />
      </a>
      <a class="fe-today" href={calendar.todayHref}>{t('calendar.today')}</a>
      <a href={calendar.nextHref} rel="next" aria-label={t('common.next')}>
        <Icon name="chevron-down" size={16} class="fe-next" />
      </a>
    </nav>
  </div>

  <div class="fe-scroll">
    <table class="fe-cal">
      <caption class="fe-sr">{calendar.label}</caption>
      <thead>
        <tr>{calendar.weekdays.map(day => <th scope="col">{day}</th>)}</tr>
      </thead>
      <tbody>
        {calendar.weeks.map(week => (
          <tr>
            {week.map(day => (
              <td class:list={[{ out: !day.inMonth, today: day.isToday }]}>
                <span class="fe-daynum">{formatNumber(day.dayOfMonth, locale)}</span>
                {day.events.length > 0 && (
                  <ul>
                    {day.events.map(item => (
                      <li>
                        <a href={`/${vm.eventPath}/${item.slug}`}>
                          <time datetime={item.startsAt}>{formatTime(item.startsAt, locale, vm.timeZone)}</time>
                          <span>{resolveText(item.title, locale)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Band>

<style>
  .fe-sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }

  .fe-monthbar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--fe-space-4); margin-block-end: var(--fe-space-6);
  }
  .fe-monthbar h2 { margin: 0; font-family: var(--fe-font-body); font-size: var(--fe-size-lg); font-weight: var(--fe-weight-semibold); }
  .fe-monthbar nav { display: flex; align-items: stretch; }
  .fe-monthbar nav a {
    display: grid; place-items: center;
    min-inline-size: 2.4rem; block-size: 2.4rem; padding-inline: var(--fe-space-3);
    border: 1px solid var(--fe-color-border);
    color: var(--fe-color-text); text-decoration: none;
    font-size: var(--fe-size-2xs); font-weight: var(--fe-weight-semibold);
    text-transform: uppercase; letter-spacing: 0.14em;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .fe-monthbar nav a + a { border-inline-start: 0; }
  .fe-monthbar nav a:hover { background: var(--fe-color-primary); color: var(--fe-color-primaryText); }
  :global(.fe-prev) { transform: rotate(90deg); }
  :global(.fe-next) { transform: rotate(-90deg); }

  .fe-scroll { overflow-x: auto; }
  .fe-cal { inline-size: 100%; border-collapse: collapse; table-layout: fixed; min-inline-size: 44rem; }
  .fe-cal th {
    padding: var(--fe-space-3);
    background: var(--fe-color-primary); color: var(--fe-color-primaryText);
    font-family: var(--fe-font-body);
    font-size: var(--fe-size-3xs); font-weight: var(--fe-weight-semibold);
    text-transform: uppercase; letter-spacing: 0.16em; text-align: start;
  }
  .fe-cal td {
    vertical-align: top; block-size: 6.5rem; padding: var(--fe-space-3);
    border: 1px solid var(--fe-color-border);
  }
  .fe-cal td.out { background: var(--fe-color-surface); }
  .fe-cal td.out .fe-daynum { opacity: 0.4; }
  .fe-cal td.today { box-shadow: inset 0 3px 0 0 var(--fe-color-accent); }
  .fe-cal td.today .fe-daynum { color: var(--fe-color-accent); font-weight: var(--fe-weight-semibold); }

  .fe-daynum { display: block; font-size: var(--fe-size-sm); font-variant-numeric: tabular-nums; color: var(--fe-color-textMuted); }

  .fe-cal ul { list-style: none; margin: var(--fe-space-2) 0 0; padding: 0; display: grid; gap: 3px; }
  .fe-cal li a {
    display: grid; gap: 1px; padding: var(--fe-space-2);
    background: var(--fe-color-surface);
    border-inline-start: 3px solid var(--fe-color-accent);
    text-decoration: none; color: var(--fe-color-text);
    transition: background-color 200ms ease;
  }
  .fe-cal li a:hover { background: var(--fe-color-border); }
  .fe-cal li time { color: var(--fe-color-textMuted); font-size: var(--fe-size-3xs); font-variant-numeric: tabular-nums; }
  .fe-cal li span { font-size: var(--fe-size-3xs); line-height: var(--fe-leading-snug); }

  @media (max-width: 47.99rem) { .fe-cal td { block-size: 5rem; } }
</style>
