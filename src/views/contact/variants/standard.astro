---
import Container from '../../../ui/Container.astro'
import Field from '../../../ui/Field.astro'
import FormResult from '../../../ui/FormResult.astro'
import Icon from '../../../ui/Icon.astro'
import PageHeading from '../../../ui/PageHeading.astro'
import type { ContactViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: ContactViewModel; locale: Locale; t: Translator }
const { vm, locale, t }: Props = Astro.props
const { profile, submission } = vm
const errors = submission.errors
const value = (field: string) => submission.values[field] ?? ''
---
<Container>
  <PageHeading title={resolveText(vm.title, locale)} />

  <div class="fe-contact">
    <section aria-labelledby="h-form">
      <h2 id="h-form">{t('contact.formTitle')}</h2>
      <FormResult submission={submission} t={t} />

      <form method="post" class="fe-form" novalidate>
        <input type="hidden" name="_form" value="contact.message" />
        <!-- Hidden from people and from screen readers; bots fill it in and are
             quietly discarded. The tempting field name is the whole bait. -->
        <p class="fe-trap" aria-hidden="true">
          <input name="_website" type="text" tabindex="-1" autocomplete="off" />
        </p>

        <Field name="name" label={t('contact.name')} t={t} value={value('name')} error={errors.name} required autocomplete="name" />
        <div class="fe-pair">
          <Field name="phone" label={t('contact.phone')} t={t} type="tel" value={value('phone')} error={errors.phone} autocomplete="tel" inputmode="tel" />
          <Field name="email" label={t('contact.email')} t={t} type="email" value={value('email')} error={errors.email} autocomplete="email" inputmode="email" />
        </div>
        <Field name="subject" label={t('contact.subject')} t={t} value={value('subject')} error={errors.subject} required />
        <Field name="message" label={t('contact.message')} t={t} type="textarea" value={value('message')} error={errors.message} required />

        <p><button type="submit">{t('form.send')}</button></p>
      </form>
    </section>

    <aside>
      <h2>{resolveText(profile.name, locale)}</h2>
      <dl>
        {profile.address && (
          <div><dt><Icon name="pin" size={15} />{t('contact.address')}</dt><dd>{resolveText(profile.address, locale)}</dd></div>
        )}
        {profile.phones.length > 0 && (
          <div>
            <dt><Icon name="phone" size={15} />{t('contact.phone')}</dt>
            <dd>{profile.phones.map(number => <a href={`tel:${number}`}>{number}</a>)}</dd>
          </div>
        )}
        {profile.emails.length > 0 && (
          <div>
            <dt><Icon name="mail" size={15} />{t('contact.email')}</dt>
            <dd>{profile.emails.map(address => <a href={`mailto:${address}`}>{address}</a>)}</dd>
          </div>
        )}
      </dl>
      {profile.mapEmbedUrl && (
        <iframe class="fe-map" src={profile.mapEmbedUrl} loading="lazy" title={t('contact.address')}></iframe>
      )}
    </aside>
  </div>
</Container>

<style>
  .fe-contact { display: grid; gap: var(--fe-space-12); }
  @media (min-width: 60rem) { .fe-contact { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }

  h2 { margin: 0 0 var(--fe-space-4); padding-block-end: var(--fe-space-2); border-block-end: 2px solid var(--fe-color-primary); font-size: var(--fe-size-lg); }

  .fe-form { display: grid; gap: var(--fe-space-4); }
  .fe-pair { display: grid; gap: var(--fe-space-4); }
  @media (min-width: 30rem) { .fe-pair { grid-template-columns: 1fr 1fr; } }
  .fe-trap { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }

  button {
    justify-self: start;
    padding: var(--fe-space-3) var(--fe-space-8);
    border: 0; border-radius: var(--fe-radius-sm);
    background: var(--fe-color-primary); color: var(--fe-color-primaryText);
    font: inherit; font-size: var(--fe-size-sm); font-weight: var(--fe-weight-semibold);
    cursor: pointer;
  }
  button:hover { background: color-mix(in srgb, var(--fe-color-primary) 88%, black); }
  .fe-form p { margin: 0; }

  dl { margin: 0; display: grid; gap: var(--fe-space-4); }
  dt { display: flex; align-items: center; gap: var(--fe-space-2); color: var(--fe-color-textMuted); font-size: var(--fe-size-2xs); text-transform: uppercase; letter-spacing: var(--fe-tracking-caps); }
  dd { margin: var(--fe-space-1) 0 0; font-size: var(--fe-size-sm); }
  dd a { display: block; color: var(--fe-color-primary); text-decoration: none; }
  .fe-map { inline-size: 100%; min-block-size: 16rem; margin-block-start: var(--fe-space-6); border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-sm); }
</style>
