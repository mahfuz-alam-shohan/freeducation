---
import Container from '../../../ui/Container.astro'
import EmptyState from '../../../ui/EmptyState.astro'
import type { HomeViewModel } from '../viewModel.js'
import type { Locale } from '../../../contracts/index.js'
import { formatDate, resolveText, type Translator } from '../../../i18n/index.js'

interface Props { vm: HomeViewModel; locale: Locale; t: Translator }
const { vm, locale, t } = Astro.props
---
<section class="fe-hero">
  <Container class="fe-hero-inner">
    <div>
      <h1>{resolveText(vm.profile.name, locale)}</h1>
      {vm.profile.tagline && <p class="fe-tagline">{resolveText(vm.profile.tagline, locale)}</p>}
      {vm.profile.address && <p class="fe-address">{resolveText(vm.profile.address, locale)}</p>}
    </div>
    <ul class="fe-stats">
      {vm.stats.map(stat => (
        <li><strong>{stat.value}</strong><span>{resolveText(stat.label, locale)}</span></li>
      ))}
    </ul>
  </Container>
</section>

<Container>
  <div class="fe-columns">
    <section aria-labelledby="home-notices">
      <h2 id="home-notices">{t('home.notices')}</h2>
      {vm.notices.length === 0 ? <EmptyState message={t('notice.empty')} /> : (
        <ul class="fe-list">
          {vm.notices.map(notice => (
            <li>
              <a href={`/${vm.noticesPath}/${notice.slug}`}>{resolveText(notice.title, locale)}</a>
              <time datetime={notice.publishedAt}>{formatDate(notice.publishedAt, locale)}</time>
            </li>
          ))}
        </ul>
      )}
      <a class="fe-more" href={`/${vm.noticesPath}`}>{t('common.viewAll')} &rarr;</a>
    </section>

    <section aria-labelledby="home-events">
      <h2 id="home-events">{t('home.events')}</h2>
      {vm.events.length === 0 ? <EmptyState message={t('event.empty')} /> : (
        <ul class="fe-list">
          {vm.events.map(event => (
            <li>
              <a href={`/events/${event.slug}`}>{resolveText(event.title, locale)}</a>
              <time datetime={event.startsAt}>{formatDate(event.startsAt, locale)}</time>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Container>

<style>
  .fe-hero { background: var(--fe-color-primary); color: var(--fe-color-primaryText); padding-block: var(--fe-space-12); }
  :global(.fe-hero-inner) { display: grid; gap: var(--fe-space-8); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); align-items: center; }
  .fe-hero h1 { font-family: var(--fe-font-heading); font-size: var(--fe-size-3xl); line-height: var(--fe-leading-tight); margin: 0; }
  .fe-tagline { font-size: var(--fe-size-lg); margin: var(--fe-space-3) 0 0; opacity: 0.9; }
  .fe-address { margin: var(--fe-space-2) 0 0; opacity: 0.75; font-size: var(--fe-size-sm); }
  /* A ruled row rather than floating tiles: closer to a printed prospectus. */
  .fe-stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--fe-space-4) 0; }
  @media (min-width: 48rem) { .fe-stats { grid-template-columns: repeat(4, 1fr); gap: 0; } }
  .fe-stats li { padding: var(--fe-space-2) var(--fe-space-4); border-inline-start: 1px solid var(--fe-color-onPrimarySurface); }
  .fe-stats li:nth-child(odd) { border-inline-start: 0; padding-inline-start: 0; }
  @media (min-width: 48rem) {
    .fe-stats li:nth-child(odd) { border-inline-start: 1px solid var(--fe-color-onPrimarySurface); padding-inline-start: var(--fe-space-4); }
    .fe-stats li:first-child { border-inline-start: 0; padding-inline-start: 0; }
  }
  .fe-stats strong { display: block; font-family: var(--fe-font-heading); font-size: var(--fe-size-2xl); line-height: var(--fe-leading-tight); font-weight: 400; }
  .fe-stats span { display: block; margin-block-start: var(--fe-space-1); font-size: var(--fe-size-xs); text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.8; }

  .fe-columns { display: grid; gap: var(--fe-space-8); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); padding-block: var(--fe-space-12); }
  h2 { font-family: var(--fe-font-heading); font-size: var(--fe-size-xl); margin: 0 0 var(--fe-space-4); color: var(--fe-color-text); }
  .fe-list { list-style: none; margin: 0; padding: 0; }
  .fe-list li { display: flex; flex-wrap: wrap; gap: var(--fe-space-2); justify-content: space-between; padding: var(--fe-space-3) 0; border-bottom: 1px solid var(--fe-color-border); }
  .fe-list a { color: var(--fe-color-text); text-decoration: none; }
  .fe-list a:hover { color: var(--fe-color-primary); text-decoration: underline; }
  .fe-list time { color: var(--fe-color-textMuted); font-size: var(--fe-size-xs); white-space: nowrap; }
  .fe-more { display: inline-block; margin-top: var(--fe-space-4); color: var(--fe-color-primary); text-decoration: none; font-size: var(--fe-size-sm); }
</style>
