---
/**
 * Inline line icons. Drawn rather than pulled from an icon font or an emoji, so they
 * inherit colour and stroke weight and stay crisp at small sizes.
 */
export type IconName =
  | 'home' | 'notice' | 'results' | 'search' | 'menu' | 'close'
  | 'chevron-down' | 'arrow-right' | 'phone' | 'mail' | 'pin' | 'download' | 'theme'

interface Props {
  name: IconName
  size?: number | undefined
  class?: string | undefined
}
const { name, size = 20, class: className }: Props = Astro.props

const paths: Record<IconName, string> = {
  'home': 'M3 10.5 12 3l9 7.5M5.5 9.5V20h13V9.5M9.5 20v-6h5v6',
  'notice': 'M6 9a6 6 0 1 1 12 0c0 4 1.5 5.5 2 6H4c.5-.5 2-2 2-6M10 19a2 2 0 0 0 4 0',
  'results': 'M8 4h8v5a4 4 0 0 1-8 0zM8 5H5v2a3 3 0 0 0 3 3M16 5h3v2a3 3 0 0 1-3 3M12 13v4M9 20h6',
  'search': 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14M16.5 16.5 21 21',
  'menu': 'M4 7h16M4 12h16M4 17h16',
  'close': 'm6 6 12 12M18 6 6 18',
  'chevron-down': 'm6 9 6 6 6-6',
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'phone': 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1',
  'mail': 'M3 6h18v12H3zM3 7l9 6 9-6',
  'pin': 'M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11M12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5',
  'download': 'M12 3v11M7.5 10 12 14.5 16.5 10M5 19h14',
  'theme': 'M12 3a9 9 0 1 0 0 18zM12 3a9 9 0 0 1 0 18',
}
---
<svg
  class:list={['fe-icon', className]}
  width={size} height={size} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.6"
  stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false"
><path d={paths[name]} /></svg>
<style>
  .fe-icon { display: block; flex: none; }
</style>
