---
interface Props { as?: string; class?: string }
const { as: Tag = 'div', class: className = '' }: Props = Astro.props
---
<Tag class:list={['fe-container', className]}><slot /></Tag>
<style>
  .fe-container {
    width: 100%;
    max-width: var(--fe-container-max);
    margin-inline: auto;
    padding-inline: var(--fe-space-4);
  }
</style>
