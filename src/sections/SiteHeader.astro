---
import Container from '../ui/Container.astro'
import Icon from '../ui/Icon.astro'
import type { Locale, MenuItem, Navigation, Notice, SchoolProfile } from '../contracts/index.js'
import { resolveText, type Translator } from '../i18n/index.js'
import { normalisePath } from '../routing/resolver.js'

interface Props {
  navigation: Navigation
  profile: SchoolProfile
  locale: Locale
  locales: Locale[]
  t: Translator
  currentPath: string
  features: { languageSwitch: boolean; themeToggle: boolean; search: boolean }
  searchPath?: string | undefined
  ticker?: Notice[] | undefined
}
const {
  navigation, profile, locale, locales, t, currentPath, features, searchPath, ticker = [],
}: Props = Astro.props

const here = normalisePath(currentPath)
const href = (item: MenuItem) => item.externalUrl ?? `/${normalisePath(item.path)}`
const visible = (items: MenuItem[]) => items.filter(item => item.visible)

const isActive = (item: MenuItem) => {
  const path = normalisePath(item.path)
  const own = path === here || (path !== '' && here.startsWith(`${path}/`))
  return own || item.children.some(child => normalisePath(child.path) === here)
}

const primary = visible(navigation.primary)
const highlighted = primary.filter(item => item.highlighted)
---
<header class="fe-header">
  <!-- Phone: one compact sticky bar. Everything else is in the drawer or the tab bar. -->
  <div class="fe-phonebar">
    <a class="fe-phone-brand" href="/">
      {profile.logo?.url && <img src={profile.logo.url} alt="" width="26" height="26" />}
      <span>{resolveText(profile.shortName ?? profile.name, locale)}</span>
    </a>
    {features.search && searchPath && (
      <a href={`/${searchPath}`} aria-label={t('common.search')}><Icon name="search" size={20} /></a>
    )}
  </div>

  <div class="fe-utility">
    <Container class="fe-utility-inner">
      <span class="fe-ident">
        {resolveText(profile.name, locale)}{profile.eiin && <> · {t('common.eiin')} {profile.eiin}</>}
      </span>
      <div class="fe-utility-actions">
        {profile.phones[0] && <a href={`tel:${profile.phones[0]}`}>{profile.phones[0]}</a>}
        {features.search && searchPath && (
          <form class="fe-search" method="get" action={`/${searchPath}`} role="search">
            <Icon name="search" size={15} />
            <label class="fe-sr" for="fe-site-search">{t('search.placeholder')}</label>
            <input id="fe-site-search" name="q" type="search" placeholder={t('search.placeholder')} />
          </form>
        )}
        {features.languageSwitch && locales.length > 1 && (
          <span class="fe-langs">
            {locales.map(code => (
              <a href={`?lang=${code}`} aria-current={code === locale ? 'true' : undefined}>
                {code === 'bn' ? 'বাংলা' : 'English'}
              </a>
            ))}
          </span>
        )}
        {features.themeToggle && (
          <button type="button" data-fe-theme-toggle aria-label={t('common.theme')}><Icon name="theme" size={16} /></button>
        )}
        {visible(navigation.utility).map(item => <a href={href(item)}>{resolveText(item.label, locale)}</a>)}
      </div>
    </Container>
  </div>

  {ticker.length > 0 && (
    <div class="fe-ticker">
      <Container class="fe-ticker-inner">
        <span class="fe-ticker-label">{t('ticker.label')}</span>
        <div class="fe-ticker-viewport">
          <ul class="fe-ticker-track" aria-label={t('ticker.label')}>
            {ticker.map(notice => (
              <li><a href={`/notice/${notice.slug}`}>{resolveText(notice.title, locale)}</a></li>
            ))}
          </ul>
        </div>
      </Container>
    </div>
  )}

  <Container class="fe-masthead">
    <a class="fe-brand" href="/">
      {profile.logo?.url && <img class="fe-mark" src={profile.logo.url} alt="" width="52" height="52" />}
      <span>
        <strong>{resolveText(profile.name, locale)}</strong>
        {profile.tagline && <small>{resolveText(profile.tagline, locale)}</small>}
      </span>
    </a>
    <div class="fe-cta">
      {highlighted.map(item => (
        <a class="fe-cta-link" href={href(item)}>
          {resolveText(item.label, locale)}<Icon name="arrow-right" size={15} />
        </a>
      ))}
    </div>
  </Container>

  <nav class="fe-nav" aria-label={t('common.menu')}>
    <Container>
      <ul class="fe-menu">
        {primary.map(item => (
          <li class:list={['fe-menu-item', { 'has-children': visible(item.children).length > 0 }]}>
            <a href={href(item)} aria-current={isActive(item) ? 'page' : undefined}>
              {resolveText(item.label, locale)}
              {visible(item.children).length > 0 && <Icon name="chevron-down" size={13} class="fe-caret" />}
            </a>
            {visible(item.children).length > 0 && (
              <div class="fe-submenu">
                <ul>
                  {visible(item.children).map(child => (
                    <li>
                      <a href={href(child)} aria-current={normalisePath(child.path) === here ? 'page' : undefined}>
                        {resolveText(child.label, locale)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </Container>
  </nav>
</header>

<style>
  .fe-header { background: var(--fe-color-bg); }
  .fe-sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }

  /* ---------- phone bar ---------- */
  .fe-phonebar {
    display: none;
    position: sticky; inset-block-start: 0; z-index: 40;
    align-items: center; justify-content: space-between; gap: var(--fe-space-2);
    padding-inline: var(--fe-space-2);
    background: color-mix(in srgb, var(--fe-color-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid var(--fe-color-border);
    padding-block-start: env(safe-area-inset-top);
  }
  .fe-phonebar > a:last-child:not(.fe-phone-brand) {
    display: grid; place-items: center; inline-size: 44px; block-size: 46px;
    color: var(--fe-color-text);
    -webkit-tap-highlight-color: transparent;
  }
  .fe-phone-brand {
    flex: 1; min-inline-size: 0; text-decoration: none;
    display: flex; align-items: center; gap: var(--fe-space-2);
    padding-inline-start: var(--fe-space-2);
    block-size: 46px;
    font-family: var(--fe-font-heading); font-size: var(--fe-size-base);
    letter-spacing: var(--fe-tracking-tight); color: var(--fe-color-text);
  }
  .fe-phone-brand span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fe-phone-brand img { flex: none; inline-size: 26px; block-size: 26px; }
  .fe-phone-spacer { inline-size: 44px; }

  /* ---------- utility strip ---------- */
  .fe-utility { background: var(--fe-color-surface); border-block-end: 1px solid var(--fe-color-border); font-size: var(--fe-size-2xs); }
  :global(.fe-utility-inner) { display: flex; flex-wrap: wrap; gap: var(--fe-space-2) var(--fe-space-4); justify-content: space-between; align-items: center; padding-block: var(--fe-space-2); color: var(--fe-color-textMuted); }
  .fe-ident { letter-spacing: var(--fe-tracking-wide); }
  .fe-utility-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--fe-space-3); }
  .fe-utility a { color: inherit; text-decoration: none; }
  .fe-utility a:hover { color: var(--fe-color-primary); }
  .fe-utility button { display: grid; place-items: center; border: 0; background: none; color: inherit; cursor: pointer; padding: 0; }
  .fe-langs { display: inline-flex; gap: var(--fe-space-2); }
  .fe-langs a[aria-current='true'] { color: var(--fe-color-primary); font-weight: var(--fe-weight-semibold); }
  .fe-search { display: flex; align-items: center; gap: var(--fe-space-2); padding-inline: var(--fe-space-2); border: 1px solid var(--fe-color-border); border-radius: var(--fe-radius-sm); background: var(--fe-color-bg); }
  .fe-search input { inline-size: 9rem; padding-block: 3px; border: 0; background: none; color: var(--fe-color-text); font: inherit; font-size: var(--fe-size-2xs); }
  .fe-search input:focus { outline: none; }

  /* ---------- ticker ---------- */
  .fe-ticker { border-block-end: 1px solid var(--fe-color-border); overflow: hidden; }
  :global(.fe-ticker-inner) { display: flex; align-items: center; gap: var(--fe-space-3); padding-block: var(--fe-space-2); }
  .fe-ticker-label { flex: none; padding-inline-end: var(--fe-space-3); border-inline-end: 1px solid var(--fe-color-border); color: var(--fe-color-accent); font-size: var(--fe-size-2xs); font-weight: var(--fe-weight-bold); text-transform: uppercase; letter-spacing: var(--fe-tracking-caps); white-space: nowrap; }
  .fe-ticker-viewport { flex: 1; overflow: hidden; }
  .fe-ticker-track { display: flex; gap: var(--fe-space-8); list-style: none; margin: 0; padding: 0; white-space: nowrap; animation: fe-ticker-scroll 38s linear infinite; }
  .fe-ticker-viewport:hover .fe-ticker-track, .fe-ticker-viewport:focus-within .fe-ticker-track { animation-play-state: paused; }
  .fe-ticker-track a { color: var(--fe-color-text); text-decoration: none; font-size: var(--fe-size-sm); }
  .fe-ticker-track a:hover { color: var(--fe-color-primary); }
  @keyframes fe-ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .fe-ticker-track { animation: none; overflow-x: auto; } }

  /* ---------- masthead ---------- */
  :global(.fe-masthead) { display: flex; flex-wrap: wrap; gap: var(--fe-space-4); align-items: center; justify-content: space-between; padding-block: var(--fe-space-4); }
  .fe-brand { display: flex; align-items: center; gap: var(--fe-space-4); text-decoration: none; color: var(--fe-color-text); }
  .fe-mark { flex: none; inline-size: 52px; block-size: 52px; }
  .fe-brand strong { display: block; font-family: var(--fe-font-heading); font-size: var(--fe-size-xl); font-weight: var(--fe-weight-semibold); line-height: var(--fe-leading-tight); letter-spacing: var(--fe-tracking-tight); }
  .fe-brand small { display: block; margin-block-start: 2px; color: var(--fe-color-textMuted); font-size: var(--fe-size-2xs); text-transform: uppercase; letter-spacing: var(--fe-tracking-caps); }
  .fe-cta { display: flex; gap: var(--fe-space-2); }
  .fe-cta-link { display: inline-flex; align-items: center; gap: var(--fe-space-2); background: var(--fe-color-primary); color: var(--fe-color-primaryText); padding: var(--fe-space-2) var(--fe-space-4); border-radius: var(--fe-radius-sm); text-decoration: none; font-size: var(--fe-size-sm); font-weight: var(--fe-weight-semibold); }
  .fe-cta-link:hover { background: color-mix(in srgb, var(--fe-color-primary) 88%, black); }

  /* ---------- primary nav ---------- */
  .fe-nav { border-block: 1px solid var(--fe-color-border); background: var(--fe-color-bg); }
  .fe-menu { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  .fe-menu > li > a {
    display: flex; align-items: center; gap: var(--fe-space-1);
    padding: var(--fe-space-3) var(--fe-space-4);
    color: var(--fe-color-text); text-decoration: none;
    font-size: var(--fe-size-sm); font-weight: var(--fe-weight-medium);
    border-block-end: 2px solid transparent; margin-block-end: -1px;
  }
  .fe-menu > li:first-child > a { padding-inline-start: 0; }
  .fe-menu > li > a:hover { color: var(--fe-color-primary); }
  .fe-menu > li > a[aria-current='page'] { color: var(--fe-color-primary); border-block-end-color: var(--fe-color-primary); }
  .fe-caret { color: var(--fe-color-textMuted); }

  .fe-menu-item { position: relative; }
  .fe-submenu { position: absolute; inset-block-start: 100%; inset-inline-start: 0; min-inline-size: 15rem; background: var(--fe-color-bg); border: 1px solid var(--fe-color-border); box-shadow: var(--fe-shadow-md); display: none; z-index: 30; }
  .fe-menu-item:hover > .fe-submenu, .fe-menu-item:focus-within > .fe-submenu { display: block; }
  .fe-submenu ul { list-style: none; margin: 0; padding: var(--fe-space-2) 0; }
  .fe-submenu a { display: block; padding: var(--fe-space-2) var(--fe-space-4); color: var(--fe-color-text); text-decoration: none; font-size: var(--fe-size-sm); }
  .fe-submenu a:hover { background: var(--fe-color-surface); color: var(--fe-color-primary); }
  .fe-submenu a[aria-current='page'] { color: var(--fe-color-primary); font-weight: var(--fe-weight-medium); }

  /* Below this width the drawer and tab bar take over entirely. */
  @media (max-width: 59.99rem) {
    .fe-phonebar { display: flex; }
    .fe-utility, .fe-nav { display: none; }
    :global(.fe-masthead) { display: none; }
  }
</style>
