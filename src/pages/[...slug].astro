---
import Base from '../layouts/Base.astro'
import { loadSchool } from '../config/index.js'
import { createClient, fixtureSource, httpSource } from '../data/index.js'
import { buildRoutes, matchRoute } from '../routing/resolver.js'
import { controllers, isRenderable } from '../views/controllers.js'
import { activeVariants } from 'virtual:fe/active-variants'
import { createTranslator, resolveText } from '../i18n/index.js'
import type { Locale } from '../contracts/index.js'

// One route serves every page a school defines. Adding a page is a menu edit, not a deploy.
const config = loadSchool()

const source = config.data.source === 'http'
  ? httpSource({
      baseUrl: config.data.baseUrl ?? '',
      apiKey: import.meta.env.CONTENT_API_KEY,
      tenant: config.data.tenant,
    })
  : fixtureSource()

const client = createClient(source)

const requestedLocale = Astro.url.searchParams.get('lang') as Locale | null
const locale: Locale = requestedLocale && config.locales.supported.includes(requestedLocale)
  ? requestedLocale
  : config.locales.default
const t = createTranslator(locale)

const [navigation, profile] = await Promise.all([
  client.get('site.navigation'),
  client.get('site.profile'),
])

const currentPath = Astro.params.slug ?? ''
const routes = buildRoutes(navigation)
const route = matchRoute(routes, currentPath)

if (!route || !isRenderable(route.view)) {
  return new Response(null, { status: 404 })
}

const viewModel = await controllers[route.view]({ client, locale, route, config, url: Astro.url })

const load = activeVariants[route.view]
if (!load) return new Response(null, { status: 404 })
const Variant = (await load()).default

const title = route.path === '' ? '' : resolveText(route.item.label, locale)

// The search box and ticker are driven by the menu and the school's feature flags.
const searchPath = routes.find(candidate => candidate.view === 'search')?.path
const ticker = config.features.noticeTicker
  ? (await client.get('notice.list', { pageSize: 6 })).items
  : []
---
<Base
  config={config} navigation={navigation} profile={profile} locale={locale} t={t}
  title={title} currentPath={currentPath} searchPath={searchPath} ticker={ticker}
>
  <Variant vm={viewModel} locale={locale} t={t} />
</Base>
