---
import Base from '../layouts/Base.astro'
import { loadSite } from '../runtime/site.js'
import { handleSubmission, idleSubmission } from '../runtime/forms.js'
import { matchRoute } from '../routing/resolver.js'
import { controllers, isRenderable } from '../views/controllers.js'
import { metaOf } from '../views/types.js'
import { activeVariants } from 'virtual:fe/active-variants'
import { resolveText } from '../i18n/index.js'
import { normalisePath } from '../routing/resolver.js'
import type { Crumb } from '../sections/Breadcrumbs.astro'

// One route serves every page a school defines. Adding a page is a menu edit, not a deploy.
const site = await loadSite(Astro.url)
const { config, client, locale, t, navigation, profile, routes } = site

const currentPath = Astro.params.slug ?? ''
const route = matchRoute(routes, currentPath)

if (!route || !isRenderable(route.view)) {
  return new Response(null, { status: 404 })
}

// Forms post back to their own page, so a rejected form can be re-rendered with its
// values and errors in place. This works with JavaScript switched off.
const submission = Astro.request.method === 'POST'
  ? await handleSubmission(client, Astro.request)
  : idleSubmission

const viewModel = await controllers[route.view]({
  client, locale, route, config, url: Astro.url, submission,
})

const load = activeVariants[route.view]
if (!load) return new Response(null, { status: 404 })
const Variant = (await load()).default

const meta = metaOf(viewModel)
const isHome = route.path === ''

// A detail page names itself: a shared notice link should show its headline, not
// the label of the list it came from.
const isDetail = route.path !== normalisePath(route.item.path)
const title = isHome ? '' : (meta.title ?? resolveText(route.item.label, locale))

const crumbs: Crumb[] = isHome ? [] : [
  ...route.trail.map(item => ({
    label: resolveText(item.label, locale),
    href: `/${normalisePath(item.path)}`,
  })),
  ...(isDetail && meta.title ? [{ label: meta.title }] : []),
]

// The last crumb is the current page, so it is not a link.
const lastCrumb = crumbs[crumbs.length - 1]
if (lastCrumb) delete lastCrumb.href
---
<Base
  config={config} navigation={navigation} profile={profile} locale={locale} t={t}
  title={title} currentPath={currentPath}
  searchPath={site.searchPath} ticker={site.ticker}
  crumbs={crumbs}
  description={meta.description} image={meta.image}
>
  <Variant vm={viewModel} locale={locale} t={t} />
</Base>
