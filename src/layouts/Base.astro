---
import DemoBar from '../sections/DemoBar.astro'
import SiteHeader from '../sections/SiteHeader.astro'
import SiteFooter from '../sections/SiteFooter.astro'
import Breadcrumbs from '../sections/Breadcrumbs.astro'
import Decor from '../ui/Decor.astro'
import NavTray from '../sections/NavTray.astro'
import MobileTabBar, { type Tab } from '../sections/MobileTabBar.astro'
import { baseTokens, darkPresets, tokensToCss, themePresets, type TokenName } from '../tokens/tokens.js'
import { demos, demoContext } from '../demo/index.js'
import type { Crumb } from '../sections/Breadcrumbs.astro'
import type { Locale, Navigation, Notice, SchoolProfile } from '../contracts/index.js'
import { resolveText, type Translator } from '../i18n/index.js'
import type { SchoolConfig } from '../config/index.js'
// Self-hosted so there is no third-party request on a school's homepage. Each file
// declares unicode-range per subset, so a Bangla page never downloads Cyrillic or Greek.
import '@fontsource-variable/inter/wght.css'
import '@fontsource-variable/anek-bangla/wght.css'
import '@fontsource-variable/source-serif-4/wght.css'
import '@fontsource/tiro-bangla/bengali.css'
import '../styles/global.css'

interface Props {
  config: SchoolConfig
  navigation: Navigation
  profile: SchoolProfile
  locale: Locale
  t: Translator
  title: string
  currentPath: string
  searchPath?: string | undefined
  ticker?: Notice[] | undefined
  /** The path to this page. Empty on the home page. */
  crumbs?: Crumb[] | undefined
  /** Shown in search results and link previews. */
  description?: string | undefined
  image?: string | undefined
}
const {
  config, navigation, profile, locale, t, title, currentPath, searchPath, ticker,
  crumbs = [], description, image,
}: Props = Astro.props

const preset = themePresets[config.theme.preset] ?? {}
// The phone browser chrome takes the school's own colour.
const themeColor = (config.theme.overrides as Record<string, string>)['color.primary']
  ?? preset['color.primary']
  ?? baseTokens['color.primary']
// A school's own overrides apply to both modes: they are its colours, not its daylight.
const chosen = config.theme.overrides as Partial<Record<TokenName, string>>
const themeCss = tokensToCss(
  { ...preset, ...chosen },
  { ...(darkPresets[config.theme.preset] ?? {}), ...chosen },
)
// Only a demonstration carries the switcher; a real school's config leaves it off.
const demo = config.features.demoBar ? demoContext(config.slug) : null
const siteName = resolveText(profile.name, locale)
const pageTitle = title ? `${title} · ${siteName}` : siteName
const summary = description ?? resolveText(profile.tagline, locale)

// Canonical and preview URLs come from the live request, so each school's own
// domain is correct without any per-school build configuration.
// The tab bar mirrors what the school actually published: a tab is left out when the
// menu has no page for it, rather than linking somewhere that does not exist.
const pathFor = (view: string) => {
  const search = (items: typeof navigation.primary): string | undefined => {
    for (const item of items) {
      if (item.view === view && item.visible !== false) return item.path.replace(/^\/+/, '')
      const nested = search(item.children)
      if (nested !== undefined) return nested
    }
    return undefined
  }
  return search([...navigation.primary, ...navigation.footer, ...navigation.utility])
}

const noticePath = pathFor('notice-list')
const resultsPath = pathFor('result-lookup')
const current = currentPath.replace(/^\/+|\/+$/g, '')

const tabs: Tab[] = [
  { href: '/', label: t('common.home'), icon: 'home', active: current === '' },
  ...(noticePath !== undefined
    ? [{ href: `/${noticePath}`, label: t('notice.title'), icon: 'notice' as const, active: current === noticePath || current.startsWith(`${noticePath}/`) }]
    : []),
  ...(resultsPath !== undefined
    ? [{ href: `/${resultsPath}`, label: t('result.submit'), icon: 'results' as const, active: current === resultsPath }]
    : []),
  ...(searchPath !== undefined
    ? [{ href: `/${searchPath}`, label: t('common.search'), icon: 'search' as const, active: current === searchPath }]
    : []),
]

const canonical = new URL(Astro.url.pathname, Astro.url.origin).href
const previewImage = image ? new URL(image, Astro.url.origin).href : undefined
---
<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {profile.logo?.url && (
      <>
        <link rel="icon" href={profile.logo.url} />
        <link rel="apple-touch-icon" href={profile.logo.url} />
      </>
    )}
    <meta name="theme-color" content={themeColor} />
    {summary && <meta name="description" content={summary} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'bn' ? 'bn_BD' : 'en_GB'} />
    {summary && <meta property="og:description" content={summary} />}
    {previewImage && <meta property="og:image" content={previewImage} />}
    <meta name="twitter:card" content={previewImage ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href="/feed.xml" />
    <style is:inline set:html={themeCss}></style>
    <script is:inline>
      // Applied before paint so the chosen theme never flashes.
      try {
        const stored = localStorage.getItem('fe-theme')
        if (stored) document.documentElement.dataset.theme = stored
      } catch {}
    </script>
  </head>
  <body>
    <a class="fe-skip" href="#main">{t('common.skipToContent')}</a>
    {demo && (
      <DemoBar
        current={demo.current} peers={demo.peers}
        galleryUrl={demos.galleryUrl} currentPath={currentPath} t={t}
      />
    )}
    <SiteHeader
      navigation={navigation} profile={profile} locale={locale}
      locales={config.locales.supported} t={t} currentPath={currentPath}
      features={{ languageSwitch: config.features.languageSwitch, themeToggle: config.features.themeToggle, search: config.features.search }}
      searchPath={searchPath} ticker={ticker}
    />
    <Decor motif={config.decor} />
    <Breadcrumbs crumbs={crumbs} t={t} />
    <main id="main" class="fe-main"><slot /></main>
    <Decor motif={config.decor} flip />
    <SiteFooter navigation={navigation} profile={profile} locale={locale} t={t} />

    <NavTray
      items={navigation.primary} profile={profile} locale={locale}
      locales={config.locales.supported} t={t} currentPath={currentPath}
      searchPath={searchPath}
      showLanguage={config.features.languageSwitch} showTheme={config.features.themeToggle}
    />
    <MobileTabBar tabs={tabs} t={t} />

    <script>
      for (const toggle of document.querySelectorAll('[data-fe-theme-toggle]')) {
        toggle.addEventListener('click', () => {
          const root = document.documentElement
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
          root.dataset.theme = next
          try { localStorage.setItem('fe-theme', next) } catch {}
        })
      }

      const drawer = document.getElementById('fe-drawer')
      const openers = document.querySelectorAll('[data-fe-nav-open]')
      let lastFocused: HTMLElement | null = null

      const focusable = () =>
        drawer
          ? [...drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input, summary')]
              .filter(element => element.offsetParent !== null)
          : []

      function openDrawer() {
        if (!drawer) return
        lastFocused = document.activeElement as HTMLElement
        drawer.hidden = false
        // Locking the page underneath is what stops the body scrolling behind the panel.
        document.body.style.overflow = 'hidden'
        for (const opener of openers) opener.setAttribute('aria-expanded', 'true')
        focusable()[1]?.focus()
      }

      function closeDrawer() {
        if (!drawer || drawer.hidden) return
        drawer.hidden = true
        document.body.style.overflow = ''
        for (const opener of openers) opener.setAttribute('aria-expanded', 'false')
        lastFocused?.focus()
      }

      for (const opener of openers) opener.addEventListener('click', openDrawer)
      for (const closer of document.querySelectorAll('[data-fe-nav-close]')) {
        closer.addEventListener('click', closeDrawer)
      }

      document.addEventListener('keydown', event => {
        if (!drawer || drawer.hidden) return
        if (event.key === 'Escape') { closeDrawer(); return }
        if (event.key !== 'Tab') return

        // Keep focus inside the panel while it is open.
        const items = focusable()
        if (items.length === 0) return
        const first = items[0]
        const last = items[items.length - 1]
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus() }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus() }
      })

      // A drawer left open across a resize would strand the desktop layout.
      matchMedia('(min-width: 60rem)').addEventListener('change', event => {
        if (event.matches) closeDrawer()
      })
    </script>
  </body>
</html>
<style>
  .fe-main { padding-block: var(--fe-space-8); min-block-size: 58vh; }

  /* Room for the fixed tab bar so it never covers the last line of a page. */
  @media (max-width: 59.99rem) {
    .fe-main { padding-block-end: calc(var(--fe-space-16) + 56px + env(safe-area-inset-bottom)); }
  }
  .fe-skip { position: absolute; inset-inline-start: -9999px; }
  .fe-skip:focus { inset-inline-start: var(--fe-space-4); top: var(--fe-space-4); z-index: 100; background: var(--fe-color-bg); padding: var(--fe-space-3); border-radius: var(--fe-radius-sm); }
</style>
